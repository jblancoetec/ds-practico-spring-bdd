# Plantilla de variables de entorno para conexión a MariaDB.
# Copiá este archivo como .env y completá los valores con los datos
# que entregó el laboratorio. .env está ignorado por .gitignore;
# este .env.example sí se versiona como contrato.

# Activa el perfil Spring que lee los datos del aula.
SPRING_PROFILES_ACTIVE=lab

# Conexión JDBC completa (reemplazá los placeholders por los valores
# provistos por el docente). Si usás un túnel SSH local, podés
# apuntar a 127.0.0.1:3306 como en la última línea comentada.
SPRING_DATASOURCE_URL=jdbc:mariadb://HOST:PUERTO/NOMBRE_BD
# SPRING_DATASOURCE_URL=jdbc:mariadb://127.0.0.1:3306/NOMBRE_BD
SPRING_DATASOURCE_USERNAME=USUARIO
SPRING_DATASOURCE_PASSWORD=CONTRASEÑA
